# .env.example - Environment configuration for Homelab
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# ==============================================================================
# General & System Settings
# ==============================================================================
TZ=Europe/Kyiv
DATA_DIR=/opt/homelab/data
CONFIG_DIR=/opt/homelab/config

# ==============================================================================
# Networking & Domains
# ==============================================================================
# Dynamic DNS (DuckDNS)
DUCKDNS_DOMAIN=your-subdomain
DUCKDNS_TOKEN=your-duckdns-token

# Primary external domain (e.g. your-subdomain.duckdns.org or custom domain)
DOMAIN_NAME=your-subdomain.duckdns.org

# Tailscale Hostname / IP (e.g. 100.x.y.z or homelab.tailnet-name.ts.net)
TAILSCALE_IP=100.x.y.z

# Allowed Admin CIDRs (Tailscale CGNAT subnet + local home LAN)
ALLOWED_ADMIN_SUBNETS=100.64.0.0/10 192.168.0.0/16 172.16.0.0/12 10.0.0.0/8

# ==============================================================================
# Security & Passwords
# ==============================================================================
# Pi-hole Web Admin Password
PIHOLE_PASSWORD=ChangeThisSecretPassword123!

# Vaultwarden (Bitwarden)
# To generate an admin token: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=ChangeThisVaultwardenAdminToken123!
# Signups allowed? (Set to false after creating your personal account)
VAULTWARDEN_SIGNUPS_ALLOWED=true

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisGrafanaPassword123!

# ==============================================================================
# Monitoring & Alerting
# ==============================================================================
# Dead Man's Snitch ping token
DEAD_MANS_SNITCH_URL=https://nosnch.in/YOUR_TOKEN_HERE

# Uptime Kuma
UPTIME_KUMA_PORT=3001
